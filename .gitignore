# Build output
.build/
dist/
Native/*/build/
Native/*/.cache/
*.o
*.dll
*.exe
*.dylib

# Python bytecode (it embeds the absolute path of the machine it was built on)
__pycache__/
*.pyc

# macOS / editors
.DS_Store
*.xcuserstate
.swiftpm/
.vscode/
.idea/

# Secrets must never be committed (the real signing key lives outside the repo)
*.key
*.pem
*.p12
*.p8
.env
.env.*
steppe-secrets/
sparkle_ed25519_private*

# Logs and local test data
*.log
logs/
